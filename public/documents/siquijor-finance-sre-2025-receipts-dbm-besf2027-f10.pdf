      <pdfaSchema:property>
       <rdf:Seq>
        <rdf:li
         pdfaProperty:name="Producer"
         pdfaProperty:category="external"
         pdfaProperty:valueType="Text"
         pdfaProperty:description="The name of the tool that created the PDF document"/>
       </rdf:Seq>
      </pdfaSchema:property>
      <pdfaSchema:valueType>
       <rdf:Seq/>
      </pdfaSchema:valueType>
      </rdf:Description>
     </rdf:li>
     <rdf:li>
      <rdf:Description
       pdfaSchema:namespaceURI="http://ns.adobe.com/xap/1.0/"
       pdfaSchema:prefix="xmp"
       pdfaSchema:schema="XMP Basic schema">
      <pdfaSchema:property>
       <rdf:Seq>
        <rdf:li
         pdfaProperty:name="ModifyDate"
         pdfaProperty:category="external"
         pdfaProperty:valueType="Date"
         pdfaProperty:description="The date and time the resource was last modified"/>
        <rdf:li
         pdfaProperty:name="CreateDate"
         pdfaProperty:category="external"
         pdfaProperty:valueType="Date"
         pdfaProperty:description="The date and time the resource was originally created"/>
        <rdf:li
         pdfaProperty:name="MetadataDate"
         pdfaProperty:category="external"
         pdfaProperty:valueType="Date"
         pdfaProperty:description="The date and time that any metadata for this resource was last changed"/>
        <rdf:li
         pdfaProperty:name="CreatorTool"
         pdfaProperty:category="external"
         pdfaProperty:valueType="Text"
         pdfaProperty:description="The name of the first known tool used to create the resource"/>
       </rdf:Seq>
      </pdfaSchema:property>
      <pdfaSchema:valueType>
       <rdf:Seq/>
      </pdfaSchema:valueType>
      </rdf:Description>
     </rdf:li>
